# HF repo id to serve. Full-precision Gemma 4 E4B (~16GB BF16 weights) does
# NOT fit a 12GB consumer GPU alongside its KV cache -- use Google's own
# QAT (quantization-aware training) checkpoint in compressed-tensors W4A16
# format instead: real weights, official source, ~4GB, vLLM-native (no
# --quantization flag needed, it's auto-detected from the checkpoint).
# Drop to google/gemma-4-E2B-it-qat-w4a16-ct for even more headroom.
MODEL_ID=google/gemma-4-E4B-it-qat-w4a16-ct

# vllm/vllm-openai image tag. Gemma 4 needs CUDA >=12.9, which the `latest`
# tag now assumes CUDA >=13.0 for -- pin to the `gemma4` tag (CUDA 12.9
# build) unless your driver supports newer. Check with: nvidia-smi
VLLM_IMAGE_TAG=gemma4

# Port the OpenAI-compatible API (and /metrics) are served on.
VLLM_PORT=8000

# Optional: set if the model repo is gated and you haven't run `huggingface-cli login`.
# HUGGING_FACE_HUB_TOKEN=
