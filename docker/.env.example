# HF repo id to serve. Google's official QAT (quantization-aware training)
# checkpoint. Bump to google/gemma-4-E4B-it-qat-w4a16-ct if you have more VRAM.
MODEL_ID=google/gemma-4-E2B-it-qat-w4a16-ct

# vllm/vllm-openai image tag. Pinned since `latest` may need a newer CUDA
# driver than you have. Check compatibility with: nvidia-smi
VLLM_IMAGE_TAG=gemma4

# Port the OpenAI-compatible API (and /metrics) are served on.
VLLM_PORT=8000

# Optional: set if the model repo is gated and you haven't run `huggingface-cli login`.
# HUGGING_FACE_HUB_TOKEN=
